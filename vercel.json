{
  "cleanUrls": false,
  "redirects": [
    { "source": "/index", "destination": "/", "statusCode": 301 },
    { "source": "/index.html", "destination": "/", "statusCode": 301 },
    { "source": "/index.php", "destination": "/", "statusCode": 301 },
    { "source": "/en/index(\\.html)?", "destination": "/en", "statusCode": 301 },
    { "source": "/ratgeber/index(\\.html)?", "destination": "/ratgeber", "statusCode": 301 },
    { "source": "/en/guides/index(\\.html)?", "destination": "/en/guides", "statusCode": 301 },
    { "source": "/(.+)/", "destination": "/$1", "statusCode": 301 },
    { "source": "/(.+)\\.html", "destination": "/$1", "statusCode": 301 },
    { "source": "/contact.php", "destination": "/kontakt", "statusCode": 301 },
    { "source": "/kontakt.php", "destination": "/kontakt", "statusCode": 301 },
    { "source": "/contact", "destination": "/kontakt", "statusCode": 301 },
    { "source": "/sendemail.php", "destination": "/kontakt", "statusCode": 301 },
    { "source": "/home", "destination": "/", "statusCode": 301 },
    { "source": "/service-details(\\.html)?", "destination": "/sichere-datenloeschung", "statusCode": 301 },
    { "source": "/service-details-2(\\.html)?", "destination": "/it-ankauf", "statusCode": 301 },
    { "source": "/service-details-3(\\.html)?", "destination": "/it-recycling", "statusCode": 301 },
    { "source": "/data-deletion(\\.html)?", "destination": "/sichere-datenloeschung", "statusCode": 301 },
    { "source": "/service(\\.html)?", "destination": "/", "statusCode": 301 },
    { "source": "/services(\\.html)?", "destination": "/", "statusCode": 301 },
    { "source": "/about(\\.html)?", "destination": "/ueber-uns", "statusCode": 301 },
    { "source": "/testimonial(\\.html)?", "destination": "/ueber-uns", "statusCode": 301 },
    { "source": "/project(\\.html)?", "destination": "/", "statusCode": 301 },
    { "source": "/project-details(\\.html)?", "destination": "/", "statusCode": 301 },
    { "source": "/impress(\\.html)?", "destination": "/impressum", "statusCode": 301 },
    { "source": "/index_en(\\.html)?", "destination": "/en", "statusCode": 301 },
    { "source": "/service-details_en(\\.html)?", "destination": "/en/secure-data-erasure", "statusCode": 301 },
    { "source": "/service-details-2_en(\\.html)?", "destination": "/en/it-buyback", "statusCode": 301 },
    { "source": "/service-details-3_en(\\.html)?", "destination": "/en/it-recycling", "statusCode": 301 },
    { "source": "/data-deletion_en(\\.html)?", "destination": "/en/secure-data-erasure", "statusCode": 301 },
    { "source": "/service_en(\\.html)?", "destination": "/en", "statusCode": 301 },
    { "source": "/services_en(\\.html)?", "destination": "/en", "statusCode": 301 },
    { "source": "/about_en(\\.html)?", "destination": "/en/about", "statusCode": 301 },
    { "source": "/testimonial_en(\\.html)?", "destination": "/en/about", "statusCode": 301 },
    { "source": "/project_en(\\.html)?", "destination": "/en", "statusCode": 301 },
    { "source": "/project-details_en(\\.html)?", "destination": "/en", "statusCode": 301 },
    { "source": "/faq_en(\\.html)?", "destination": "/en/faq", "statusCode": 301 },
    { "source": "/impress_en(\\.html)?", "destination": "/en/imprint", "statusCode": 301 },
    { "source": "/datenschutz_en(\\.html)?", "destination": "/en/privacy", "statusCode": 301 },
    { "source": "/AGB_en(\\.html)?", "destination": "/en/terms", "statusCode": 301 },
    { "source": "/contact_en(\\.html)?", "destination": "/en/contact", "statusCode": 301 },
    { "source": "/contact_en.php", "destination": "/en/contact", "statusCode": 301 },
    { "source": "/haeufige-fragen(\\.html)?", "destination": "/faq", "statusCode": 301 },
    { "source": "/dienstleistungen(\\.html)?", "destination": "/", "statusCode": 301 },
    { "source": "/it-services(\\.html)?", "destination": "/", "statusCode": 301 },
    { "source": "/it-services-berlin(\\.html)?", "destination": "/", "statusCode": 301 },
    { "source": "/it-recycling-berlin(\\.html)?", "destination": "/it-recycling", "statusCode": 301 },
    { "source": "/data-recovery(\\.html)?", "destination": "/datenrettung", "statusCode": 301 },
    { "source": "/dataprivacy(\\.html)?", "destination": "/datenschutz", "statusCode": 301 },
    { "source": "/imprint(\\.html)?", "destination": "/impressum", "statusCode": 301 },
    { "source": "/it-buyback(\\.html)?", "destination": "/it-ankauf", "statusCode": 301 },
    { "source": "/haeufige-fragen_en(\\.html)?", "destination": "/en/faq", "statusCode": 301 },
    { "source": "/dienstleistungen_en(\\.html)?", "destination": "/en", "statusCode": 301 },
    { "source": "/it-services_en(\\.html)?", "destination": "/en", "statusCode": 301 },
    { "source": "/it-services-berlin_en(\\.html)?", "destination": "/en", "statusCode": 301 },
    { "source": "/it-recycling-berlin_en(\\.html)?", "destination": "/en/it-recycling", "statusCode": 301 },
    { "source": "/it-recycling_en(\\.html)?", "destination": "/en/it-recycling", "statusCode": 301 },
    { "source": "/data-recovery_en(\\.html)?", "destination": "/en/data-recovery", "statusCode": 301 },
    { "source": "/dataprivacy_en(\\.html)?", "destination": "/en/privacy", "statusCode": 301 },
    { "source": "/imprint_en(\\.html)?", "destination": "/en/imprint", "statusCode": 301 },
    { "source": "/it-buyback_en(\\.html)?", "destination": "/en/it-buyback", "statusCode": 301 },
    { "source": "/(.*)\\.php", "destination": "/", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/ratgeber", "destination": "/ratgeber/index.html" },
    { "source": "/en/guides", "destination": "/en/guides/index.html" },
    { "source": "/:path*", "destination": "/:path*.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
